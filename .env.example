# Copy this file to .env and fill in ONE of these.
# The key stays on your machine — the browser never sees it, only the
# local proxy in scripts/server.js does.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Or, instead of Anthropic:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Port the local proxy listens on (optional)
AI_SERVER_PORT=8787
